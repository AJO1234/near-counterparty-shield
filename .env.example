# Network: mainnet (default) or testnet
NEAR_NETWORK=mainnet

# Optional overrides (comma-separated for failover)
# NEAR_RPC=https://rpc.mainnet.fastnear.com
# NEAR_ARCHIVAL_RPC=https://archival-rpc.mainnet.fastnear.com
# NEARBLOCKS_API=https://api.nearblocks.io
# NEARBLOCKS_API_KEY=

PORT=8787

# Protects the write routes (/v1/report, /v1/payments). Set this before exposing the server.
# SHIELD_API_TOKEN=

# Shield ticket signing key (ed25519, PKCS#8 PEM). If unset, data/shield-key.pem is created on first run.
# SHIELD_SIGNING_KEY=

# Your own approved receivers, added to the known-accounts list:
# SHIELD_KNOWN=vendor.near=Our data vendor,payroll.near=Payroll

# Large-payment threshold in NEAR (unknown receivers at or above this are at least WARN)
# SHIELD_LARGE_AMOUNT_NEAR=5

# Optional: a real LLM for the demo agent (any OpenAI-compatible endpoint, e.g. NEAR AI Cloud)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
